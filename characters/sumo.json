      { "draw": "ArtMeshEarsL", "root": [770, 420], "tip": [897, 358], "dir": -1, "gain": 0.28, "freq": 6, "decay": 5, "u0": 0.1, "delay": 0.05 }
    ],
    "extraParams": ["ParamTailWag"],
    "hit": {
      "head": ["ArtMeshFace", "ArtMeshFrontHair", "ArtMeshHeadwear", "ArtMeshEarsL", "ArtMeshEarsR", "ArtMeshEyewhiteL", "ArtMeshEyewhiteR", "ArtMeshIridesL", "ArtMeshIridesR", "ArtMeshEyelashL", "ArtMeshEyelashR", "ArtMeshEyeCloseL", "ArtMeshEyeCloseR", "ArtMeshEyebrowL", "ArtMeshEyebrowR", "ArtMeshMouth", "ArtMeshMouthClose"],
      "tail": ["ArtMeshTail"]
