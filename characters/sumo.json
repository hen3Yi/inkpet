    "mouthOrder": false,
    "swingFollow": [
      { "draw": "ArtMeshBackHair", "root": [646, 520], "tip": [646, 990], "u0": 0.15 }
    ],
    "limbs": [
      { "key": "armL", "draws": ["ArtMeshHandwearL", "ArtMeshLayerL"], "root": [722, 560], "tip": [845, 900], "gain": 0.42, "K": 300, "C": 14, "u0": 0.2 },
      { "key": "armR", "draws": ["ArtMeshHandwearR", "ArtMeshLayerR"], "root": [565, 560], "tip": [440, 900], "gain": 0.42, "K": 300, "C": 14, "u0": 0.2 },
      { "key": "legs", "draws": ["ArtMeshLegwear2", "ArtMeshLegwear", "ArtMeshFootwear"], "root": [640, 790], "tip": [640, 1245], "gain": 0.35, "K": 250, "C": 15 },
      { "key": "skirt", "draws": ["ArtMeshBottomwear", "ArtMeshTopwear"], "root": [640, 800], "tip": [640, 1160], "gain": 0.24, "K": 210, "C": 12 },
