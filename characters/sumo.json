      "sleeves": ["ArtMeshLayerL", "ArtMeshLayerR"],
      "boots": ["ArtMeshFootwear"],
      "horns": ["ArtMeshHeadwear"],
      "tail": ["ArtMeshTail"]
    },
    "_autoClothNote": "穿着靴子时自动隐藏脚（ArtMeshLegwear 是脚、ArtMeshLegwear2 是腿）：boots 一关自动露出脚，不用另设开关。",
    "autoCloth": [
      { "when": "boots", "hide": ["ArtMeshLegwear"] }
    ],
    "body": ["ArtMeshLayer", "ArtMeshTopwear", "ArtMeshLayerL", "ArtMeshLayerR", "ArtMeshBottomwear", "ArtMeshLegwear", "ArtMeshLegwear2", "ArtMeshFootwear", "ArtMeshHandwearL", "ArtMeshHandwearR", "ArtMeshNeck", "ArtMeshTail"],
    "head": ["ArtMeshFace", "ArtMeshEyewhiteL", "ArtMeshEyewhiteR", "ArtMeshIridesL", "ArtMeshIridesR", "ArtMeshEyelashL", "ArtMeshEyelashR", "ArtMeshEyeCloseL", "ArtMeshEyeCloseR", "ArtMeshEyebrowL", "ArtMeshEyebrowR", "ArtMeshMouth", "ArtMeshMouthClose", "ArtMeshFrontHair", "ArtMeshBackHair", "ArtMeshEarsL", "ArtMeshEarsR", "ArtMeshHeadwear"],
    "mouth": { "smile": "ArtMeshMouth", "open": "ArtMeshMouth", "triangle": "ArtMeshMouth" },
    "mouthParam": { "mix": "max", "smile": 0, "open": 0, "triangle": 1, "lo": 0.1, "hi": 1, "smooth": 18 },
